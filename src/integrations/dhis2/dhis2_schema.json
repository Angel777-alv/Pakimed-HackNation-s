{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DHIS2ClinicalEventPayload",
  "type": "object",
  "required": ["program", "orgUnit", "eventDate", "status", "dataValues"],
  "properties": {
    "program": {
      "type": "string",
      "description": "Identificador del programa de consulta primaria DHIS2"
    },
    "orgUnit": {
      "type": "string",
      "description": "Identificador de la unidad organizativa de la clínica rural"
    },
    "eventDate": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "COMPLETED", "VISITED", "SCHEDULE"]
    },
    "dataValues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dataElement", "value"],
        "properties": {
          "dataElement": { "type": "string" },
          "value": { "type": "string" }
        }
      }
    }
  }
}
